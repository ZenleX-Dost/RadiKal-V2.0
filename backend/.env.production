# =============================================================================
# RadiKal XAI Quality Control - Production Environment Configuration
# =============================================================================

# Application
ENVIRONMENT=production
DEBUG=False
APP_NAME="RadiKal XAI Quality Control"
APP_VERSION="2.0.0"

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Security (CHANGE THESE IN PRODUCTION!)
SECRET_KEY=your-secret-key-change-this-in-production-use-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS - Add your production domains
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Database - Supabase PostgreSQL
DATABASE_TYPE=supabase
SUPABASE_DB_URL=postgresql://postgres.your-project:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ML Models
DEVICE=cuda
YOLO_MODEL_PATH=models/yolo/classification_defect_focused/weights/best.pt
BATCH_SIZE=32
CONFIDENCE_THRESHOLD=0.5

# MLflow Tracking
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=radikal-production

# Storage
UPLOAD_DIR=/data/uploads
EXPORTS_DIR=/data/exports
MAX_UPLOAD_SIZE_MB=10

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=100

# Monitoring & Logging
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
LOG_LEVEL=INFO
LOG_FILE=/var/log/radikal/app.log

# Email Alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@yourdomain.com
SMTP_PASSWORD=your-email-password
ALERT_EMAIL=admin@yourdomain.com

# =============================================================================
# Production Deployment Checklist:
# =============================================================================
# 
# [ ] Change SECRET_KEY to a long random string
# [ ] Update SUPABASE_DB_URL with your database credentials
# [ ] Update SUPABASE_URL and keys
# [ ] Add your production domain to ALLOWED_ORIGINS
# [ ] Configure Sentry DSN for error tracking
# [ ] Set up email SMTP for alerts
# [ ] Review and adjust rate limits
# [ ] Ensure SSL certificates are configured
# [ ] Set up automated backups
# [ ] Configure firewall rules
# [ ] Enable monitoring and alerting
# 
# =============================================================================
